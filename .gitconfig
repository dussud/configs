[user]
	name = Flavien Dussud
	email = flavien@dussud.org
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[fetch]
	prune = true
[diff]
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
